{
  "name": "opencode-saas-kit",
  "version": "1.2.3",
  "description": "Multi-agent development team kit for OpenCode. 9 specialized AI agents work together to build SaaS products.",
  "keywords": [
    "opencode",
    "ai-agents",
    "saas",
    "nextjs",
    "nestjs",
    "prisma",
    "monorepo",
    "nx"
  ],
  "homepage": "https://github.com/naviocean/opencode-kit",
  "bugs": {
    "url": "https://github.com/naviocean/opencode-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naviocean/opencode-kit.git"
  },
  "license": "MIT",
  "author": "naviocean",
  "bin": {
    "opencode-saas-kit": "./bin/cli.js"
  },
  "files": [
    "bin/",
    ".opencode/",
    "AGENTS.md",
    "docs/",
    "opencode.json",
    "README.md"
  ],
  "scripts": {
    "test": "node .opencode/scripts/__tests__/skill-registry.test.mjs && node .opencode/scripts/__tests__/dispatch.test.mjs && node .opencode/scripts/__tests__/verify.test.mjs",
    "test:registry": "node .opencode/scripts/__tests__/skill-registry.test.mjs",
    "test:dispatch": "node .opencode/scripts/__tests__/dispatch.test.mjs",
    "test:verify": "node .opencode/scripts/__tests__/verify.test.mjs",
    "verify": "node .opencode/scripts/verify.mjs",
    "verify:cli": "node bin/cli.js verify",
    "registry": "node .opencode/scripts/skill-registry.mjs",
    "health": "node .opencode/scripts/model-health-check.mjs",
    "test:all": "npm test && npm run verify && npm run verify:cli"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
