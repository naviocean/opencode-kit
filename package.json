{
  "name": "opencode-saas-kit",
  "version": "1.3.2",
  "description": "Universal multi-agent development team kit for OpenCode, Claude Code, Antigravity, and Codex.",
  "keywords": [
    "opencode",
    "claude-code",
    "codex",
    "antigravity",
    "ai-agents",
    "saas",
    "nextjs",
    "nestjs",
    "prisma",
    "monorepo",
    "nx"
  ],
  "homepage": "https://github.com/naviocean/opencode-kit",
  "bugs": {
    "url": "https://github.com/naviocean/opencode-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naviocean/opencode-kit.git"
  },
  "license": "MIT",
  "author": "naviocean",
  "bin": {
    "opencode-saas-kit": "./bin/cli.js"
  },
  "files": [
    "bin/",
    ".agent-core/",
    ".agent-memory/",
    ".opencode/",
    "scripts/",
    "AGENTS.md",
    "docs/",
    "opencode.json",
    "README.md"
  ],
  "scripts": {
    "test": "node scripts/__tests__/skill-registry.test.mjs && node scripts/__tests__/dispatch.test.mjs && node scripts/__tests__/verify.test.mjs && node scripts/__tests__/security-gate.test.mjs && node scripts/__tests__/pre-tool-guard.test.mjs && node scripts/__tests__/sync-kit.test.mjs && node scripts/__tests__/context-marker.test.mjs && node scripts/__tests__/repo-scanner.test.mjs && node scripts/__tests__/triage-sizer.test.mjs",
    "test:registry": "node scripts/__tests__/skill-registry.test.mjs",
    "test:dispatch": "node scripts/__tests__/dispatch.test.mjs",
    "test:verify": "node scripts/__tests__/verify.test.mjs",
    "test:security": "node scripts/__tests__/security-gate.test.mjs",
    "test:guard": "node scripts/__tests__/pre-tool-guard.test.mjs",
    "test:sync": "node scripts/__tests__/sync-kit.test.mjs",
    "test:marker": "node scripts/__tests__/context-marker.test.mjs",
    "test:scanner": "node scripts/__tests__/repo-scanner.test.mjs",
    "test:sizer": "node scripts/__tests__/triage-sizer.test.mjs",
    "sync": "node scripts/sync-kit.mjs",
    "clean": "node scripts/sync-kit.mjs --clean",
    "verify": "node scripts/verify.mjs",
    "verify:cli": "node bin/cli.js verify",
    "registry": "node scripts/skill-registry.mjs",
    "health": "node scripts/model-health-check.mjs",
    "test:all": "npm test && npm run verify && npm run verify:cli"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
