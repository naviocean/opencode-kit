    { "prompt": "fix typo in login button text", "expectedSize": "S", "expectRiskFlags": true },
    { "prompt": "hotfix: fix null pointer in sidebar toggle", "expectedSize": "S", "expectRiskFlags": false },
    { "prompt": "Add OAuth2 login", "forbiddenSizes": ["S"], "requiredRiskFlag": "auth-security" },
    { "prompt": "Add Stripe webhook signature check", "expectedSize": "M", "requiredRiskFlag": "billing-payment" },
    { "prompt": "Rotate JWT signing secret", "forbiddenSizes": ["S"], "requiredRiskFlag": "crypto-secrets" },
    { "prompt": "Run database migration to drop column", "forbiddenSizes": ["S"], "requiredRiskFlag": "db-migration" },
    { "prompt": "Fix race condition in checkout mutex", "forbiddenSizes": ["S"], "requiredRiskFlag": "concurrency" },
    { "prompt": "create avatar dropdown component with test", "expectedSize": "M", "expectRiskFlags": false },
    { "prompt": "add API route for user status update", "expectedSize": "M", "expectRiskFlags": false },
    { "prompt": "implement helper utility for date formatting", "expectedSize": "M", "expectRiskFlags": false },
    { "prompt": "build complete Stripe billing subscription flow with webhooks", "expectedSize": "L", "requiredRiskFlag": "billing-payment" },
    { "prompt": "implement multi-tenant auth architecture across frontend and backend", "expectedSize": "L", "requiredRiskFlag": "auth-security" },
    { "prompt": "overhaul database schema and migration pipeline for enterprise analytics", "expectedSize": "L", "requiredRiskFlag": "db-migration" }
